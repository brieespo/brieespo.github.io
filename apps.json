{
  "_comment": "Single source of truth for the suite's app list. The hub renders from it, and sibling apps (e.g. the agenda's apps menu) fetch it so the list lives in one place instead of being hard-coded in each. Identity fields only — behaviour (headline/panel renderers) and icon SVG stay in each consumer's own JS, keyed by id. URLs are absolute so a consumer served from anywhere resolves them correctly. Every consumer keeps a built-in fallback copy, so a failed fetch degrades to a stale list rather than an empty menu.",
  "apps": [
    {
      "id": "agenda",
      "name": "Agenda",
      "url": "https://brieespo.github.io/agenda/",
      "table": "agenda_data",
      "icon": "agenda",
      "color": "var(--agenda)",
      "bg": "var(--agenda-bg)"
    },
    {
      "id": "dinner",
      "name": "Dinner Planner",
      "url": "https://brieespo.github.io/dinner-planner/",
      "table": "user_data",
      "icon": "dinner",
      "color": "var(--dinner)",
      "bg": "var(--dinner-bg)"
    },
    {
      "id": "law",
      "name": "Law School",
